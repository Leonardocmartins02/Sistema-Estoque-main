+      productSku: m.product?.sku || '',
+      quantity: m.quantity,
+      date: m.date,
+      note: m.note || null,
+    }));
+
+    res.json({ items: pageItems, total, page, pageSize });
+  } catch (err) {
+    next(err);
+  }
 });
 
 export default router;
-- 
