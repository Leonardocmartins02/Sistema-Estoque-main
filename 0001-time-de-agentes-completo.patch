From 43f094e20062e4c57d794a4ff0e7862f2abff844 Mon Sep 17 00:00:00 2001
From: Sistema-Estoque Dev <dev@sistema-estoque.local>
Date: Tue, 25 Aug 2026 18:04:10 +0000
Subject: [PATCH 1/3] fix(backend): fecha bypass de CORS por substring match
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A checagem de origem aceitava qualquer valor que apenas contivesse
"localhost" ou "127.0.0.1" (ex: evil.com/?127.0.0.1, mylocalhost.io),
mesmo em produção e com credentials habilitado. Troca por comparação
exata contra a allowlist fixa de origens de desenvolvimento.
---
 packages/backend/src/app.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/packages/backend/src/app.ts b/packages/backend/src/app.ts
index b1fc871..69a1ffa 100644
--- a/packages/backend/src/app.ts
+++ b/packages/backend/src/app.ts
@@ -22,8 +22,10 @@ export function createServer() {
         'http://127.0.0.1:5175'
       ];
       
-      // Verifica se a origem está na lista de permitidas
-      if (allowedOrigins.includes(origin) || origin.includes('localhost') || origin.includes('127.0.0.1')) {
+      // Verifica se a origem está na lista de permitidas (comparação exata,
+      // nunca por substring — "evil.com/?127.0.0.1" ou "mylocalhost.io" não
+      // podem ser aceitos só por conterem esses trechos na string da origem)
+      if (allowedOrigins.includes(origin)) {
         return callback(null, true);
       }
       
-- 
