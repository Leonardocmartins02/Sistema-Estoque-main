generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]

  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  webhookEndpointsUpdated WebhookEndpoint[] @relation("WebhookEndpointUpdatedBy")
}

model Product {
  id          String          @id @default(cuid())
  name        String
  sku         String          @unique
  description String?
  minStock    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]
}

/// Tipo de movimentação de estoque. Antes era `String`, com "IN"/"OUT"
/// garantidos apenas pela camada Zod — qualquer escrita fora das rotas
/// (seed, script, psql) podia gravar um valor fora do domínio e quebrar o
/// cálculo de saldo silenciosamente. Agora o banco garante o domínio.
/// `ADJUSTMENT` e `INITIAL_STOCK` foram adicionados na Fase 1 do plano de
/// estoque auditável: toda alteração de saldo — inclusive a criação de
/// estoque inicial e correções de inventário — passa a ter um tipo próprio
/// em vez de ser gravada como `IN` disfarçado.
enum MovementType {
  IN
  OUT
  ADJUSTMENT
  INITIAL_STOCK
}

model StockMovement {
  id        String       @id @default(cuid())
  product   Product      @relation(fields: [productId], references: [id])
  productId String
  type      MovementType
  quantity  Int
  date      DateTime     @default(now())
  note      String?
  createdAt DateTime     @default(now())

  // Campos de auditoria da Fase 1. Nullable porque linhas gravadas antes
  // desta migration não têm como preencher previousQuantity/newQuantity
  // retroativamente sem reconstruir o histórico inteiro — StockService
  // sempre preenche os quatro em toda movimentação nova.
  previousQuantity Int?
  newQuantity      Int?
  user             User?   @relation(fields: [userId], references: [id])
  userId           String?
  // Identifica a operação de negócio que originou a movimentação (ex.:
  // "PURCHASE_ORDER", "STOCK_TRANSFER") quando ela não é uma entrada/saída
  // manual — usado por funcionalidades futuras (Fase 4/5), sem FK porque a
  // entidade de origem varia por referenceType.
  referenceType String?
  referenceId   String?

  // Índices que sustentam as consultas quentes depois da Parte 3:
  // - agregação de saldo por página de produtos (`groupBy` em productId+type);
  // - histórico de baixas (`type = OUT` ordenado por data desc).
  @@index([productId, type])
  @@index([type, date])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Integrações por webhook (docs/features/integracoes-webhooks/).
//
// Outbox transacional: `WebhookEvent` + uma `WebhookDelivery` por destino
// inscrito nascem na MESMA transação da StockMovement (StockService). O
// worker (src/worker.ts) reivindica entregas com `FOR UPDATE SKIP LOCKED` e
// faz a chamada HTTP fora de qualquer transação.
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id               String    @id @default(cuid())
  url              String
  description      String?
  /// Tipos de evento inscritos (`SUBSCRIBABLE_WEBHOOK_EVENT_TYPES` em
  /// packages/shared). Validado na rota — o banco só guarda a lista.
  eventTypes       String[]
  active           Boolean   @default(true)
  /// Preenchido quando o sistema desativa sozinho (410 Gone, ou falhando há
  /// 5 dias) — o usuário vê o motivo na tela de Integrações.
  disabledReason   String?
  /// Segredo `whsec_...` cifrado com AES-256-GCM (src/webhooks/secrets.ts).
  /// HMAC precisa do segredo em claro para assinar, então não dá para guardar
  /// só um hash como a senha de usuário.
  secretCiphertext String
  /// Início da sequência atual de falhas; limpo no próximo sucesso. Base da
  /// desativação automática por "falhando há 5 dias".
  failingSince     DateTime?

  createdBy   User?    @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  updatedBy   User?    @relation("WebhookEndpointUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookEvent {
  /// Vira o header `webhook-id` — o mesmo em toda tentativa e no reenvio
  /// manual; é a chave de deduplicação do receptor.
  id         String   @id
  type       String
  /// Corpo completo `{ type, timestamp, data }` já montado (fotografia do
  /// momento — não depende do produto continuar existindo).
  payload    Json
  occurredAt DateTime
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]
}

/// "Retentando" não é status próprio: é PENDING com attemptCount > 0.
enum WebhookDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED
  CANCELLED
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  event         WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId    String
  status        WebhookDeliveryStatus @default(PENDING)
  attemptCount  Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  /// Prazo da reivindicação do worker. SENDING com prazo vencido volta a ser
  /// elegível — é o que recupera entregas de um worker que morreu no meio.
  lockedUntil   DateTime?
  deliveredAt   DateTime?
  /// Momento em que a entrega chegou a um estado final (DELIVERED, FAILED,
  /// CANCELLED) — base da retenção de 30 dias.
  finishedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  attempts WebhookAttempt[]

  @@unique([eventId, endpointId])
  // Reivindicação do worker: status pendente + vencidas primeiro. Índice
  // composto, não parcial — Prisma 5 não representa índice parcial no schema
  // (desvio da RESEARCH registrado no implementation-plan.md).
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([finishedAt])
}

model WebhookAttempt {
  id              String          @id @default(cuid())
  delivery        WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId      String
  startedAt       DateTime
  durationMs      Int
  responseStatus  Int?
  /// TIMEOUT | NETWORK | BLOCKED_DESTINATION | REDIRECT | HTTP_ERROR
  errorCode       String?
  /// Trecho da resposta/erro, limitado a 1 KB — nunca o corpo inteiro.
  responseSnippet String?

  @@index([deliveryId, startedAt])
}
