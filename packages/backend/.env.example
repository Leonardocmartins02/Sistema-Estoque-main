# PostgreSQL (dev local via docker-compose na raiz do repo: `docker compose up -d`)
DATABASE_URL="postgresql://simplestock:simplestock@localhost:5432/simplestock?schema=public"

# Banco separado usado pelos testes de integração (vitest + supertest) — nunca
# aponte para o mesmo banco do dev, os testes fazem reset de dados.
DATABASE_URL_TEST="postgresql://simplestock:simplestock@localhost:5432/simplestock_test?schema=public"

# Segredo usado para assinar os JWTs de autenticação. Gere um valor forte por
# ambiente, por exemplo: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="troque-este-valor-por-um-segredo-forte-e-unico"

# Origens permitidas por CORS, separadas por vírgula (sem espaço).
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Chave que cifra os segredos de assinatura dos webhooks guardados no banco
# (AES-256-GCM). Obrigatória: base64 de exatamente 32 bytes. Gere uma por
# ambiente e não reaproveite entre ambientes:
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Perder esta chave inutiliza os segredos já cadastrados (cada destino
# precisaria rotacionar o segredo).
WEBHOOK_SECRET_ENCRYPTION_KEY="gere-com-o-comando-acima"

# Opcionais do worker de webhooks (padrões entre parênteses):
# cronograma de retentativa em segundos, um valor por tentativa
# (0,5,300,1800,7200,18000,36000,36000); para demonstração, algo como 0,2,4,8.
# WEBHOOK_RETRY_SCHEDULE_SECONDS="0,5,300,1800,7200,18000,36000,36000"
# WEBHOOK_REQUEST_TIMEOUT_MS=15000
# WEBHOOK_POLL_INTERVAL_MS=1000
# WEBHOOK_BATCH_SIZE=10

# Server
PORT=4000
NODE_ENV=development
