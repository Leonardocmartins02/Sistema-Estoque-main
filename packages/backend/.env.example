# PostgreSQL (dev local via docker-compose na raiz do repo: `docker compose up -d`)
DATABASE_URL="postgresql://simplestock:simplestock@localhost:5432/simplestock?schema=public"

# Banco separado usado pelos testes de integração (vitest + supertest) — nunca
# aponte para o mesmo banco do dev, os testes fazem reset de dados.
DATABASE_URL_TEST="postgresql://simplestock:simplestock@localhost:5432/simplestock_test?schema=public"

# Segredo usado para assinar os JWTs de autenticação. Gere um valor forte por
# ambiente, por exemplo: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="troque-este-valor-por-um-segredo-forte-e-unico"

# Origens permitidas por CORS, separadas por vírgula (sem espaço).
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Server
PORT=4000
NODE_ENV=development
