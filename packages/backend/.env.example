# SQLite (dev)
DATABASE_URL="file:./dev.db"

# Mesmo arquivo, aberto em modo somente-leitura nativo do SQLite (?mode=ro).
# Use para qualquer inspeção/mapeamento de schema ou dado que não precise
# escrever — uma tentativa de escrita nessa conexão falha no próprio motor
# do banco, não depende de disciplina de quem está consultando.
DATABASE_URL_READONLY="file:./dev.db?mode=ro"

# Server
PORT=4000
